        <bool name="Disabled">false</bool>
        <ProtectedString name="Source"><![CDATA[--!strict
-- BikeConfig
-- Every tuning number for the beta lives here. Change a value, hit Play,
-- see the difference -- no other file needs touching.
--
-- The bike is the "E Ride Pro Mini": a 6kW / 60V electric mini pit-bike.
-- Real-world numbers it is modelled on:
--   front tyre 60/100-14, rear tyre 80/100-12, seat height 680mm,
--   handlebar width 720mm, 42 mph top speed, 210 N.m peak wheel torque.
-- Those proportions are kept, but scaled up so a Roblox character fits on it.

local BikeConfig = {}

BikeConfig.ModelName = "ERideProMini"
BikeConfig.DisplayName = "E Ride Pro Mini"

-- Where the bike parks itself, and where it returns to on RESET.
BikeConfig.SpawnCFrame = CFrame.new(0, 4, 40)

-- Teal frame, blacked-out components, red shock. Riders can repaint the frame
-- and rims in game; these are the defaults.
BikeConfig.Colors = {
	Frame = Color3.fromRGB(24, 128, 126),
	FrameDark = Color3.fromRGB(15, 90, 90),
	Component = Color3.fromRGB(26, 27, 30),
	Rim = Color3.fromRGB(26, 27, 30),
	Rubber = Color3.fromRGB(18, 18, 20),
	Accent = Color3.fromRGB(196, 32, 38),
	Silver = Color3.fromRGB(190, 194, 200),
	DarkMetal = Color3.fromRGB(58, 60, 64),
	Gold = Color3.fromRGB(198, 158, 72),
	Plate = Color3.fromRGB(232, 233, 236),
	Headlight = Color3.fromRGB(255, 246, 214),
	Taillight = Color3.fromRGB(255, 40, 40),
	Screen = Color3.fromRGB(12, 16, 18),
}

-- All geometry is in studs, in bike-local space:
--   +X = rider's right, +Y = up, -Z = forward.
BikeConfig.Geometry = {
	Rake = 26, -- steering head angle, degrees back from vertical

	FrontAxle = Vector3.new(0, 1.65, -3.8),
	RearAxle = Vector3.new(0, 1.55, 3.2),
	SteerHead = Vector3.new(0, 3.30, -2.95),

	FrontRadius = 1.65,
	FrontWidth = 0.95,
	RearRadius = 1.55,
	RearWidth = 1.25,

	-- The one colliding body part. Kept clear of both tyres: parts joined by
	-- constraints still collide with each other, so any overlap here would
	-- jam the wheels against the frame.
	ChassisSize = Vector3.new(1.35, 1.45, 3.10),
	ChassisCentre = Vector3.new(0, 2.62, -0.15),

	TreadCount = 20,
	SpokeCount = 16,
	ChainLinks = 24,
	SpringCoils = 14,
}

BikeConfig.Drive = {
	MaxWheelSpeed = 42, -- rad/s at the rear wheel (~65 studs/s)
	MotorTorque = 260000,
	MotorAcceleration = 340,
	ReverseFactor = 0.35,
	BrakeTorque = 25000, -- weak, so releasing the throttle coasts
}

BikeConfig.Handling = {
	MaxSteerAngle = 32, -- visual front-wheel lock, degrees
	SteerSpeed = 14, -- rad/s the servo can move the forks
	TurnRate = 105, -- degrees/sec of chassis yaw at full steer
	TurnSpeedThreshold = 12, -- studs/s needed before steering has full bite
	MaxHeadingLag = 0.40, -- radians the steering target may lead the chassis
	StabilizerTorque = 4e6,
	StabilizerResponsiveness = 45,

	-- A bike banks into a corner. Roll is still fully controlled -- it just
	-- follows the steering instead of being pinned at zero.
	MaxLean = 30, -- degrees of bank at full lock and full speed
	LeanSpeed = 7, -- how quickly it rolls in and out of the bank
	LeanWheelieScale = 0.35, -- you cannot lean much when up on the back wheel
}

-- The wheelie is a real balance problem, not a fixed angle. The bike's pitch
-- is an inverted pendulum: below BalanceAngle gravity pulls the nose down,
-- above it gravity pulls you over backwards, and at BalanceAngle it does
-- nothing. Holding the wheelie control adds lift. Feathering it to sit in the
-- pocket is the skill of the whole game.
BikeConfig.Wheelie = {
	BalanceAngle = 34, -- degrees where gravity is neutral
	SweetSpot = 6, -- +/- degrees around it that counts as balanced
	LoopOutAngle = 63, -- past this you go over the back
	MinAngle = -16, -- how far the nose can drop (airborne only)

	LiftTorque = 190, -- deg/s^2 while the wheelie control is held
	ThrottleAssist = 50, -- extra lift per unit of throttle
	LiftFalloff = 16, -- degrees past balance over which lift fades out, so you
	LiftFloor = 0.3, -- cannot simply power through the tipping point
	ReleaseTorque = 50, -- chopping the throttle actively drops the nose
	NoseDownTorque = 250, -- braking pulls it down -- the save, on road or in air
	GravityTorque = 120, -- deg/s^2 of pendulum gravity, at 90 deg from balance
	Damping = 4.5, -- 1/s while the nose is rising
	FallDamping = 2.6, -- less on the way down, so it drops with some weight
	AirGravityScale = 0.12, -- gravity barely acts on pitch while airborne

	TurnPenalty = 0.45, -- fraction of steering lost at full lift
}

-- Tricks. Each is a rider pose held while its key is down; poses live in
-- RiderPose. Air-only ones refuse to fire with a wheel on the ground.
BikeConfig.Tricks = {
	{ Id = "Stand", Name = "STAND UP", Key = "E", AirOnly = false },
	{ Id = "NoHander", Name = "NO-HANDER", Key = "F", AirOnly = false },
	{ Id = "Superman", Name = "SUPERMAN", Key = "G", AirOnly = true },
	{ Id = "CanCan", Name = "CAN-CAN", Key = "H", AirOnly = true },
}

BikeConfig.Jump = {
	Power = 58, -- studs/sec of upward launch
	ForwardBoost = 12, -- studs/sec added along the bike's heading
	Cooldown = 0.5,
	GroundCheck = 0.85, -- clearance under a tyre that still counts as grounded
}

BikeConfig.Crash = {
	LandingSafeMin = -13, -- land nose-down past this and you case it
	LandingSafeMax = 56, -- land nose-up past this and you loop out
	ImpactSpeed = 115, -- studs/s of downward speed that always crashes
	RagdollTime = 2.8, -- seconds on the floor before you get back up
	EjectImpulse = 46, -- how hard the rider is thrown off
}

-- The stand-up-on-the-pegs pose. Angles are degrees; the rig is posed
-- procedurally rather than with an uploaded animation.
BikeConfig.Rider = {
	BlendSpeed = 7,
	StandLift = 1.25,
	StandForward = 0.55,
	StandPitch = -8,
}

BikeConfig.Camera = {
	Enabled = true, -- riders can toggle back to the default camera with V
	Distance = 23,
	Height = 7.5,
	LookHeight = 3.2,
	Smoothness = 9, -- higher follows more tightly
	BaseFov = 70,
	MaxFov = 88,
	FovSpeed = 70, -- studs/s at which MaxFov is reached
	MinDistance = 6, -- how close it may pull in to clear a wall
}

BikeConfig.Audio = {
	-- PLACEHOLDER. These are sounds that ship with Roblox, so the game makes
	-- noise out of the box with nothing to upload. For a real motor, paste an
	-- engine-whine asset id from the Creator Store into EngineSoundId.
	EngineSoundId = "rbxasset://sounds/action_swim.mp3",
	EngineVolume = 0.5,
	IdlePitch = 0.5,
	MaxPitch = 2.2,
	LandSoundId = "rbxasset://sounds/impact_water.mp3",
	LandVolume = 0.45,
	CrashSoundId = "rbxasset://sounds/snap.mp3",
	CrashVolume = 0.8,
}

-- What riders can change on the bike. The client only ever sends an index
-- into these lists, so a bad message cannot paint the bike an arbitrary value.
BikeConfig.Paint = {
	Frame = {
		{ Name = "Teal", Color = Color3.fromRGB(24, 128, 126) },
		{ Name = "Black", Color = Color3.fromRGB(26, 27, 30) },
		{ Name = "Red", Color = Color3.fromRGB(178, 32, 38) },
		{ Name = "Orange", Color = Color3.fromRGB(226, 118, 26) },
		{ Name = "Purple", Color = Color3.fromRGB(108, 56, 168) },
		{ Name = "White", Color = Color3.fromRGB(228, 230, 234) },
	},
	Rim = {
		{ Name = "Black", Color = Color3.fromRGB(26, 27, 30) },
		{ Name = "Gold", Color = Color3.fromRGB(198, 158, 72) },
		{ Name = "Silver", Color = Color3.fromRGB(190, 194, 200) },
		{ Name = "Red", Color = Color3.fromRGB(178, 32, 38) },
		{ Name = "Teal", Color = Color3.fromRGB(24, 128, 126) },
	},
	Tyre = { "Knobbly", "Street" },
}

BikeConfig.World = {
	FloorSize = Vector3.new(1024, 2, 1024),
	FloorColor = Color3.fromRGB(126, 127, 130),
	FallResetY = -50,
}

return BikeConfig
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX5">
      <Properties>
        <string name="Name">BikeBuilder</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source"><![CDATA[--!strict
-- BikeBuilder
-- Builds the E Ride Pro Mini out of parts at runtime, so the bike can be
-- re-tuned from BikeConfig without re-modelling anything by hand.
--
-- Physical layout -- only three parts collide with the world:
--   Chassis      -- the body; everything cosmetic welds to it
--   FrontWheel   -- hinged to the SteerColumn (free spinning)
--   RearWheel    -- hinged to the Chassis (motor driven)
-- plus:
--   SteerColumn  -- hinged to the chassis on the raked steering axis (servo)
--   Stabilizer   -- AlignOrientation on the chassis; keeps the bike upright and
--                   is also what pitches it back for the wheelie
--
-- Roblox only disables collisions between *welded* parts, so the three
-- colliding bodies get explicit NoCollisionConstraints between them. Without
-- those the tyres grind against the frame and the bike refuses to move.

local Config = require(script.Parent.BikeConfig)

local BikeBuilder = {}

local G = Config.Geometry
local C = Config.Colors

local CHASSIS_PROPS = PhysicalProperties.new(6.0, 0.35, 0.15, 1, 1)
local WHEEL_PROPS = PhysicalProperties.new(1.6, 2.4, 0.1, 12, 1)
local COLUMN_PROPS = PhysicalProperties.new(1.0, 0.30, 0.20, 1, 1)

--------------------------------------------------------------------------------
-- helpers
--------------------------------------------------------------------------------

type PartOpts = {
	shape: Enum.PartType?,
	collide: boolean?,
	massless: boolean?,
	transparency: number?,
	material: Enum.Material?,
	physical: PhysicalProperties?,
	reflectance: number?,
	paint: string?, -- marks the part as repaintable: "Frame", "Rim", "Tyre", "Knob"
}

local function newPart(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, opts: PartOpts?): Part
	local o: PartOpts = opts or {}
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = o.material or Enum.Material.SmoothPlastic
	p.Shape = o.shape or Enum.PartType.Block
	p.Anchored = false
	p.CanCollide = o.collide == true
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = o.massless ~= false
	p.Transparency = o.transparency or 0
	p.Reflectance = o.reflectance or 0
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if o.physical then
		p.CustomPhysicalProperties = o.physical
	end
	if o.paint then
		p:SetAttribute("Paint", o.paint)
	end
	p.Parent = parent
	return p
end

local function weld(a: BasePart, b: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = a
end

local function noCollide(a: BasePart, b: BasePart)
	local nc = Instance.new("NoCollisionConstraint")
	nc.Part0 = a
	nc.Part1 = b
	nc.Parent = a
end

-- Two attachments sharing one world-space frame, one on each part.
local function attachPair(a: BasePart, b: BasePart, worldCF: CFrame, name: string): (Attachment, Attachment)
	local a0 = Instance.new("Attachment")
	a0.Name = name .. "A"
	a0.CFrame = a.CFrame:Inverse() * worldCF
	a0.Parent = a

	local a1 = Instance.new("Attachment")
	a1.Name = name .. "B"
	a1.CFrame = b.CFrame:Inverse() * worldCF
	a1.Parent = b

	return a0, a1
end

-- A tube running between two points. Returns a CFrame with its long axis on Z,
-- plus the length -- ready to feed straight into newPart.
local function tube(from: Vector3, to: Vector3): (CFrame, number)
	local delta = to - from
	local length = delta.Magnitude
	local up = Vector3.new(0, 1, 0)
	if math.abs(delta.Unit:Dot(up)) > 0.99 then
		up = Vector3.new(0, 0, 1)
	end
	return CFrame.lookAt((from + to) * 0.5, to, up), length
end

-- A frame sitting at `from` and looking down the axis toward `to`, so local
-- -Z advances along the axis. Used for laying things out on a helix or a line.
local function axisFrame(from: Vector3, to: Vector3): (CFrame, number)
	local delta = to - from
	local dir = delta.Unit
	local up = Vector3.new(0, 1, 0)
	if math.abs(dir:Dot(up)) > 0.99 then
		up = Vector3.new(0, 0, 1)
	end
	local right = dir:Cross(up).Unit
	return CFrame.fromMatrix(from, right, right:Cross(dir)), delta.Magnitude
end

--------------------------------------------------------------------------------
-- wheels
--------------------------------------------------------------------------------

local function buildWheel(model: Model, name: string, center: Vector3, radius: number, width: number, base: CFrame): Part
	local wheelCF = base * CFrame.new(center)

	-- Cylinder parts spin about their local X axis, which is the rider's
	-- right/left -- exactly the axle direction we want.
	local wheel = newPart(model, name, Vector3.new(width, radius * 2, radius * 2), wheelCF, C.Rubber, {
		shape = Enum.PartType.Cylinder,
		collide = true,
		massless = false,
		physical = WHEEL_PROPS,
		paint = "Tyre",
	})

	local function bolt(p: Part)
		weld(wheel, p)
	end

	-- Rim: a black barrel with a machined lip on each shoulder.
	bolt(newPart(model, name .. "Rim", Vector3.new(width * 0.86, radius * 1.20, radius * 1.20), wheelCF, C.Rim, {
		shape = Enum.PartType.Cylinder,
		material = Enum.Material.Metal,
		reflectance = 0.06,
		paint = "Rim",
	}))
	for _, side in { -1, 1 } do
		bolt(newPart(
			model,
			name .. "RimLip" .. (side < 0 and "L" or "R"),
			Vector3.new(0.1, radius * 1.34, radius * 1.34),
			wheelCF * CFrame.new(side * width * 0.42, 0, 0),
			C.Silver,
			{ shape = Enum.PartType.Cylinder, material = Enum.Material.Metal, reflectance = 0.2 }
		))
	end

	-- Hub and axle.
	bolt(newPart(model, name .. "Hub", Vector3.new(width * 1.12, radius * 0.46, radius * 0.46), wheelCF, C.Silver, {
		shape = Enum.PartType.Cylinder,
		material = Enum.Material.Metal,
		reflectance = 0.15,
	}))
	bolt(newPart(model, name .. "Axle", Vector3.new(width * 1.55, 0.22, 0.22), wheelCF, C.DarkMetal, {
		shape = Enum.PartType.Cylinder,
		material = Enum.Material.Metal,
	}))

	for i = 1, G.SpokeCount do
		local a = (i / G.SpokeCount) * math.pi * 2
		-- Alternate spokes lace to opposite rim shoulders, like a real wheel.
		local lace = (i % 2 == 0) and 1 or -1
		bolt(newPart(
			model,
			name .. "Spoke" .. i,
			Vector3.new(radius * 0.92, 0.06, 0.06),
			wheelCF * CFrame.new(lace * width * 0.22, 0, 0) * CFrame.Angles(a, 0, 0) * CFrame.new(0, radius * 0.52, 0) * CFrame.Angles(0, 0, math.pi / 2),
			C.Silver,
			{ shape = Enum.PartType.Cylinder, material = Enum.Material.Metal, reflectance = 0.2 }
		))
	end

	-- Knobbly dirt tread: staggered inner and outer rows.
	for i = 1, G.TreadCount do
		local a = (i / G.TreadCount) * math.pi * 2
		local offset = (i % 2 == 0) and width * 0.22 or -width * 0.22
		bolt(newPart(
			model,
			name .. "Knob" .. i,
			Vector3.new(width * 0.44, 0.17, radius * 0.30),
			wheelCF * CFrame.Angles(a, 0, 0) * CFrame.new(offset, radius, 0),
			C.Rubber,
			{ paint = "Knob" }
		))
		bolt(newPart(
			model,
			name .. "Shoulder" .. i,
			Vector3.new(width * 0.2, 0.14, radius * 0.24),
			wheelCF * CFrame.Angles(a + math.pi / G.TreadCount, 0, 0) * CFrame.new(-offset * 1.9, radius * 0.96, 0),
			C.Rubber,
			{ paint = "Knob" }
		))
	end

	-- Brake rotor on the rider's left, drilled, with a floating carrier.
	local rotorX = -(width * 0.5 + 0.1)
	bolt(newPart(model, name .. "Rotor", Vector3.new(0.08, radius * 1.42, radius * 1.42), wheelCF * CFrame.new(rotorX, 0, 0), C.Silver, {
		shape = Enum.PartType.Cylinder,
		material = Enum.Material.Metal,
		reflectance = 0.25,
	}))
	bolt(newPart(model, name .. "RotorCarrier", Vector3.new(0.1, radius * 0.62, radius * 0.62), wheelCF * CFrame.new(rotorX, 0, 0), C.Gold, {
		shape = Enum.PartType.Cylinder,
		material = Enum.Material.Metal,
	}))
	for i = 1, 8 do
		local a = (i / 8) * math.pi * 2
		bolt(newPart(
			model,
			name .. "RotorHole" .. i,
			Vector3.new(0.12, 0.2, 0.2),
			wheelCF * CFrame.new(rotorX, 0, 0) * CFrame.Angles(a, 0, 0) * CFrame.new(0, radius * 0.55, 0),
			C.Component,
			{ shape = Enum.PartType.Cylinder }
		))
	end

	return wheel
end

--------------------------------------------------------------------------------
-- build
--------------------------------------------------------------------------------

function BikeBuilder.Build(baseCF: CFrame): Model
	local model = Instance.new("Model")
	model.Name = Config.ModelName

	local rake = math.rad(G.Rake)
	local raked = CFrame.Angles(rake, 0, 0) -- +X rotation tips the top backwards

	local function L(x: number, y: number, z: number): CFrame
		return baseCF * CFrame.new(x, y, z)
	end

	-- Round tubing. A cylinder Part spins about its local X, so the tube frame
	-- (long axis on Z) is turned a quarter turn to line the two up.
	local function tubePart(host: BasePart, name: string, from: Vector3, to: Vector3, thickness: number, color: Color3, material: Enum.Material?): Part
		local cf, length = tube(from, to)
		local p = newPart(model, name, Vector3.new(length, thickness, thickness), baseCF * cf * CFrame.Angles(0, math.pi / 2, 0), color, {
			shape = Enum.PartType.Cylinder,
			material = material or Enum.Material.Metal,
		})
		weld(host, p)
		return p
	end

	-- A ball at a tube junction, so the frame reads as welded rather than as
	-- cylinders with visible flat end caps.
	local function node(host: BasePart, name: string, at: Vector3, size: number, color: Color3)
		weld(host, newPart(model, name, Vector3.new(size, size, size), L(at.X, at.Y, at.Z), color, {
			shape = Enum.PartType.Ball,
			material = Enum.Material.Metal,
		}))
	end

	-- A curved panel swept around a wheel: fenders and huggers, instead of a
	-- flat slab floating over the tyre.
	local function arcPanel(host: BasePart, name: string, centre: Vector3, radius: number, fromDeg: number, toDeg: number, width: number, thickness: number, segments: number, color: Color3)
		for i = 0, segments - 1 do
			local t0 = math.rad(fromDeg + (toDeg - fromDeg) * (i / segments))
			local t1 = math.rad(fromDeg + (toDeg - fromDeg) * ((i + 1) / segments))
			local mid = (t0 + t1) * 0.5
			local span = radius * math.abs(t1 - t0) * 1.12
			local radial = Vector3.new(0, math.cos(mid), math.sin(mid))
			local pos = centre + radial * radius
			weld(
				host,
				newPart(
					model,
					name .. i,
					Vector3.new(width, thickness, span),
					baseCF * CFrame.fromMatrix(pos, Vector3.new(1, 0, 0), radial),
					color
				)
			)
		end
	end

	----------------------------------------------------------------------------
	-- chassis
	----------------------------------------------------------------------------

	local chassis = newPart(model, "Chassis", G.ChassisSize, baseCF * CFrame.new(G.ChassisCentre), C.Frame, {
		collide = true,
		massless = false,
		transparency = 1,
		physical = CHASSIS_PROPS,
	})
	model.PrimaryPart = chassis

	local function onFrame(p: Part): Part
		weld(chassis, p)
		return p
	end

	-- Parts that belong to the steering column but are convenient to describe
	-- alongside their chassis-side neighbours; welded once the column exists.
	local onColumnLater: { { any } } = {}

	-- Battery pack: the big swappable box that fills the frame triangle.
	onFrame(newPart(model, "BatteryBox", Vector3.new(1.42, 2.05, 2.45), L(0, 2.45, 0.35), C.Component, {
		material = Enum.Material.Metal,
	}))
	onFrame(newPart(model, "BatteryTrim", Vector3.new(1.48, 0.2, 2.5), L(0, 1.50, 0.35), C.Frame, {
		material = Enum.Material.Metal,
	}))
	onFrame(newPart(model, "BatteryTop", Vector3.new(1.44, 0.42, 1.0), L(0, 3.30, 0.30), C.DarkMetal, {
		material = Enum.Material.DiamondPlate,
	}))
	onFrame(newPart(model, "ChargePort", Vector3.new(0.3, 0.3, 0.22), L(0.72, 2.9, 1.35), C.Frame, {
		shape = Enum.PartType.Cylinder,
		material = Enum.Material.Metal,
	}))
	-- Rounded corners down the pack, so it is not a bare box.
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			onFrame(newPart(
				model,
				"BatteryEdge" .. (sx < 0 and "L" or "R") .. (sz < 0 and "F" or "B"),
				Vector3.new(2.05, 0.3, 0.3),
				L(sx * 0.71, 2.45, 0.35 + sz * 1.22) * CFrame.Angles(0, 0, math.pi / 2),
				C.Component,
				{ shape = Enum.PartType.Cylinder, material = Enum.Material.Metal }
			))
		end
	end
	-- Cooling fins down each flank of the pack.
	for i = 0, 4 do
		for _, side in { -1, 1 } do
			onFrame(newPart(
				model,
				"BatteryFin" .. i .. (side < 0 and "L" or "R"),
				Vector3.new(0.06, 1.3, 0.16),
				L(side * 0.74, 2.35, -0.55 + i * 0.44),
				C.DarkMetal,
				{ material = Enum.Material.Metal }
			))
		end
	end

	-- Frame: twin-spar tubes in the frame colour.
	tubePart(chassis, "TopTube", G.SteerHead, Vector3.new(0, 3.55, -0.30), 0.34, C.Frame)
	tubePart(chassis, "TopTubeRear", Vector3.new(0, 3.55, -0.30), Vector3.new(0, 3.52, 0.95), 0.30, C.Frame)
	tubePart(chassis, "DownTube", Vector3.new(0, 2.40, -2.60), Vector3.new(0, 1.72, -0.55), 0.36, C.Frame)
	tubePart(chassis, "CradleTube", Vector3.new(0, 1.72, -0.55), Vector3.new(0, 1.80, 1.00), 0.32, C.Frame)
	tubePart(chassis, "HeadGusset", G.SteerHead, Vector3.new(0, 2.40, -2.60), 0.44, C.Frame)
	tubePart(chassis, "HeadStay", Vector3.new(0, 3.20, -2.75), Vector3.new(0, 2.55, -2.10), 0.24, C.Frame)

	node(chassis, "NodeHead", G.SteerHead, 0.5, C.Frame)
	node(chassis, "NodeSeat", Vector3.new(0, 3.55, -0.30), 0.4, C.Frame)
	node(chassis, "NodeCradle", Vector3.new(0, 1.72, -0.55), 0.42, C.Frame)
	node(chassis, "NodeDown", Vector3.new(0, 2.40, -2.60), 0.46, C.Frame)

	for _, side in { -1, 1 } do
		local tag = side < 0 and "L" or "R"
		tubePart(chassis, "Subframe" .. tag, Vector3.new(side * 0.42, 3.50, -0.10), Vector3.new(side * 0.40, 3.62, 2.70), 0.26, C.Frame)
		tubePart(chassis, "SubBrace" .. tag, Vector3.new(side * 0.44, 2.30, 1.05), Vector3.new(side * 0.40, 3.55, 1.90), 0.22, C.Frame)
		tubePart(chassis, "PegMount" .. tag, Vector3.new(side * 0.42, 1.90, 0.85), Vector3.new(side * 0.92, 1.95, 0.85), 0.26, C.FrameDark)

		-- Swingarm: tapered box-section arm with a chain slider and adjuster.
		tubePart(chassis, "Swingarm" .. tag, Vector3.new(side * 0.55, 2.05, 0.95), Vector3.new(side * 0.62, 1.55, 3.20), 0.38, C.Silver)
		tubePart(chassis, "SwingBrace" .. tag, Vector3.new(side * 0.55, 2.05, 1.15), Vector3.new(side * 0.60, 1.72, 2.30), 0.20, C.Silver)
		onFrame(newPart(model, "AxleAdjuster" .. tag, Vector3.new(0.16, 0.5, 0.7), L(side * 0.62, 1.55, 3.18), C.DarkMetal, {
			material = Enum.Material.Metal,
		}))
	end
	onFrame(newPart(model, "SwingPivot", Vector3.new(1.5, 0.4, 0.4), L(0, 2.05, 0.95), C.DarkMetal, {
		shape = Enum.PartType.Cylinder,
		material = Enum.Material.Metal,
	}))
	onFrame(newPart(model, "ChainSlider", Vector3.new(0.2, 0.22, 1.5), L(0.66, 2.02, 1.55), C.Component))

	-- Rear monoshock with a visible coil spring.
	local shockTop = Vector3.new(0, 3.30, 1.05)
	local shockBottom = Vector3.new(0, 1.95, 2.20)
	local shockCF, shockLen = tube(shockTop, shockBottom)
	onFrame(newPart(model, "ShockBody", Vector3.new(shockLen, 0.34, 0.34), baseCF * shockCF * CFrame.Angles(0, math.pi / 2, 0), C.DarkMetal, {
		shape = Enum.PartType.Cylinder,
		material = Enum.Material.Metal,
	}))
	onFrame(newPart(model, "ShockReservoir", Vector3.new(0.28, 0.28, 0.7), baseCF * tube(Vector3.new(0.3, 3.05, 1.35), Vector3.new(0.3, 2.65, 1.70)), C.Gold, {
		material = Enum.Material.Metal,
	}))

	local springFrame, springLen = axisFrame(shockTop, shockBottom)
	for i = 0, G.SpringCoils do
		local t = i / G.SpringCoils
		local a = t * math.pi * 2 * 4.5
		onFrame(newPart(
			model,
			"SpringCoil" .. i,
			Vector3.new(0.16, 0.16, 0.16),
			baseCF * springFrame * CFrame.new(math.cos(a) * 0.26, math.sin(a) * 0.26, -t * springLen),
			C.Accent,
			{ shape = Enum.PartType.Ball, material = Enum.Material.Metal }
		))
	end

	-- Mid-mounted motor with cooling fins.
	onFrame(newPart(model, "MotorCase", Vector3.new(1.0, 1.45, 1.45), L(0, 1.95, 0.55), C.DarkMetal, {
		shape = Enum.PartType.Cylinder,
		material = Enum.Material.Metal,
		reflectance = 0.1,
	}))
	for i = 0, 4 do
		onFrame(newPart(model, "MotorFin" .. i, Vector3.new(0.07, 1.6, 1.6), L(-0.4 + i * 0.2, 1.95, 0.55), C.Silver, {
			shape = Enum.PartType.Cylinder,
			material = Enum.Material.Metal,
		}))
	end
	onFrame(newPart(model, "MotorCover", Vector3.new(0.18, 1.0, 1.0), L(-0.56, 1.95, 0.55), C.Component, {
		shape = Enum.PartType.Cylinder,
		material = Enum.Material.Metal,
	}))
	onFrame(newPart(model, "Controller", Vector3.new(0.9, 0.6, 0.5), L(0, 1.62, 1.55), C.Component, {
		material = Enum.Material.Metal,
	}))

	-- Chain: front sprocket on the motor, rear sprocket on the wheel.
	local frontSprocketR = 0.40
	local rearSprocketR = 0.85
	local chainX = 0.66
	onFrame(newPart(model, "FrontSprocket", Vector3.new(0.14, frontSprocketR * 2, frontSprocketR * 2), L(chainX, 1.95, 0.55), C.Silver, {
		shape = Enum.PartType.Cylinder,
		material = Enum.Material.Metal,
	}))

	local runs = {
		{ Vector3.new(chainX, 1.95 + frontSprocketR, 0.55), Vector3.new(chainX, 1.55 + rearSprocketR, 3.20) },
		{ Vector3.new(chainX, 1.95 - frontSprocketR, 0.55), Vector3.new(chainX, 1.55 - rearSprocketR, 3.20) },
	}
	for r, run in runs do
		local runFrame, runLen = axisFrame(run[1], run[2])
		for i = 0, G.ChainLinks do
			onFrame(newPart(
				model,
				"ChainLink" .. r .. "_" .. i,
				Vector3.new(0.1, 0.2, 0.16),
				baseCF * runFrame * CFrame.new(0, 0, -(i / G.ChainLinks) * runLen),
				C.DarkMetal,
				{ material = Enum.Material.Metal, reflectance = 0.2 }
			))
		end
	end
	onFrame(newPart(model, "ChainGuard", Vector3.new(0.12, 0.42, 2.2), L(chainX + 0.14, 2.42, 1.9), C.Component, {
		material = Enum.Material.Metal,
	}))

	-- Rear brake.
	onFrame(newPart(model, "RearCaliper", Vector3.new(0.24, 0.46, 0.6), L(-0.62, 1.95, 3.10), C.Accent, {
		material = Enum.Material.Metal,
	}))
	tubePart(chassis, "RearBrakeLine", Vector3.new(-0.55, 2.05, 2.9), Vector3.new(-0.5, 2.4, 1.2), 0.08, C.Component)

	-- Footpegs, serrated.
	for _, side in { -1, 1 } do
		local tag = side < 0 and "L" or "R"
		onFrame(newPart(model, "Footpeg" .. tag, Vector3.new(0.95, 0.14, 0.34), L(side * 1.05, 1.95, 0.85), C.Silver, {
			material = Enum.Material.DiamondPlate,
		}))
		for i = 0, 3 do
			onFrame(newPart(model, "PegTooth" .. tag .. i, Vector3.new(0.12, 0.1, 0.4), L(side * (0.72 + i * 0.22), 2.02, 0.85), C.Silver, {
				material = Enum.Material.Metal,
			}))
		end

		-- Side panel with the model name on it.
		local plate = onFrame(newPart(model, "SidePlate" .. tag, Vector3.new(0.1, 1.1, 1.45), L(side * 0.80, 2.88, 0.95), C.Frame))

		local plateGui = Instance.new("SurfaceGui")
		plateGui.Face = side < 0 and Enum.NormalId.Left or Enum.NormalId.Right
		plateGui.CanvasSize = Vector2.new(290, 220)
		plateGui.LightInfluence = 0
		plateGui.Parent = plate

		local plateLabel = Instance.new("TextLabel")
		plateLabel.Size = UDim2.fromScale(1, 1)
		plateLabel.BackgroundTransparency = 1
		plateLabel.Font = Enum.Font.GothamBlack
		plateLabel.Text = "E RIDE\nPRO"
		plateLabel.TextColor3 = Color3.new(1, 1, 1)
		plateLabel.TextScaled = true
		plateLabel.Parent = plateGui
	end

	-- Seat: tapered pad with a grippy top and a rear hump.
	onFrame(newPart(model, "SeatBase", Vector3.new(1.2, 0.3, 3.0), L(0, 3.62, 1.05) * CFrame.Angles(math.rad(-3), 0, 0), C.Component, {
		material = Enum.Material.Metal,
	}))
	onFrame(newPart(model, "SeatPad", Vector3.new(1.14, 0.28, 2.9), L(0, 3.84, 1.05) * CFrame.Angles(math.rad(-3), 0, 0), C.Component, {
		material = Enum.Material.Fabric,
	}))
	onFrame(newPart(model, "SeatNose", Vector3.new(0.9, 0.24, 0.8), L(0, 3.78, -0.35) * CFrame.Angles(math.rad(-9), 0, 0), C.Component, {
		material = Enum.Material.Fabric,
	}))
	-- Rolled edges along the seat, and a rounded nose.
	for _, side in { -1, 1 } do
		onFrame(newPart(model, "SeatEdge" .. (side < 0 and "L" or "R"), Vector3.new(2.9, 0.26, 0.26), L(side * 0.55, 3.82, 1.05) * CFrame.Angles(math.rad(-3), 0, 0) * CFrame.Angles(0, math.pi / 2, 0), C.Component, {
			shape = Enum.PartType.Cylinder,
			material = Enum.Material.Fabric,
		}))
	end
	onFrame(newPart(model, "SeatTip", Vector3.new(1.1, 0.26, 0.26), L(0, 3.76, -0.72), C.Component, {
		shape = Enum.PartType.Cylinder,
		material = Enum.Material.Fabric,
	}))
	onFrame(newPart(model, "SeatHump", Vector3.new(1.05, 0.3, 0.8), L(0, 4.0, 2.3) * CFrame.Angles(math.rad(-14), 0, 0), C.Component, {
		material = Enum.Material.Fabric,
	}))

	-- Tail.
	onFrame(newPart(model, "RearFender", Vector3.new(1.15, 0.2, 2.0), L(0, 3.98, 2.75) * CFrame.Angles(math.rad(-12), 0, 0), C.Frame))
	onFrame(newPart(model, "RearFenderTip", Vector3.new(1.15, 0.2, 0.2), L(0, 4.18, 3.72), C.Frame, {
		shape = Enum.PartType.Cylinder,
	}))
	onFrame(newPart(model, "Taillight", Vector3.new(0.48, 0.22, 0.14), L(0, 3.92, 3.60), C.Taillight, {
		material = Enum.Material.Neon,
	}))
	tubePart(chassis, "TailTidy", Vector3.new(0, 3.70, 3.15), Vector3.new(0, 3.35, 3.45), 0.14, C.Component)

	-- Kickstand, folded up along the swingarm.
	tubePart(chassis, "Kickstand", Vector3.new(-0.62, 1.95, 1.25), Vector3.new(-0.72, 1.60, 2.35), 0.16, C.Component)

	-- Shrouds: the plastic panels that sweep from the steering head back over
	-- the battery and into the seat. They are what gives these bikes their
	-- silhouette, more than any single component does.
	for _, side in { -1, 1 } do
		local tag = side < 0 and "L" or "R"
		onFrame(newPart(model, "ShroudFront" .. tag, Vector3.new(0.14, 1.5, 1.9), L(side * 0.62, 3.02, -1.85) * CFrame.Angles(0, 0, side * math.rad(9)) * CFrame.Angles(math.rad(-10), 0, 0), C.Frame))
		onFrame(newPart(model, "ShroudRear" .. tag, Vector3.new(0.14, 1.25, 1.6), L(side * 0.76, 3.16, -0.45) * CFrame.Angles(0, 0, side * math.rad(4)) * CFrame.Angles(math.rad(-4), 0, 0), C.Frame))
		onFrame(newPart(model, "ShroudVent" .. tag, Vector3.new(0.1, 0.5, 1.0), L(side * 0.70, 2.72, -1.6) * CFrame.Angles(0, 0, side * math.rad(9)), C.Component))
		-- Fork guard on the lower leg.
		onColumnLater[#onColumnLater + 1] = { "ForkGuard" .. tag, Vector3.new(0.12, 1.0, 0.5), L(side * 0.70, 2.35, -3.5) * raked }
	end

	-- Bash plate under the motor, and the linkage the shock pushes on.
	onFrame(newPart(model, "BashPlate", Vector3.new(1.24, 0.16, 2.0), L(0, 1.52, 0.45) * CFrame.Angles(math.rad(-6), 0, 0), C.Silver, {
		material = Enum.Material.DiamondPlate,
	}))
	tubePart(chassis, "LinkageArm", Vector3.new(0, 1.95, 2.20), Vector3.new(0, 1.72, 1.55), 0.26, C.DarkMetal)
	tubePart(chassis, "LinkageRod", Vector3.new(0, 1.72, 1.55), Vector3.new(0, 1.98, 1.05), 0.18, C.Silver)

	-- Rear brake pedal off the right peg, with its master cylinder.
	tubePart(chassis, "BrakePedalArm", Vector3.new(0.86, 1.88, 0.95), Vector3.new(0.98, 1.72, -0.35), 0.14, C.Silver)
	onFrame(newPart(model, "BrakePedalPad", Vector3.new(0.3, 0.1, 0.5), L(1.0, 1.70, -0.5), C.Silver, {
		material = Enum.Material.DiamondPlate,
	}))
	onFrame(newPart(model, "MasterCylinder", Vector3.new(0.26, 0.6, 0.26), L(0.86, 2.25, 0.6), C.DarkMetal, {
		material = Enum.Material.Metal,
	}))

	-- Hugger, tucked in close over the rear tyre.
	arcPanel(chassis, "RearHugger", G.RearAxle, G.RearRadius + 0.42, -14, 62, 1.05, 0.14, 6, C.Component)

	-- Chain roller on the swingarm.
	onFrame(newPart(model, "ChainRoller", Vector3.new(0.22, 0.44, 0.44), L(0.66, 2.28, 1.35), C.Component, {
		shape = Enum.PartType.Cylinder,
	}))

	----------------------------------------------------------------------------
	-- steering column (everything that turns with the bars)
	----------------------------------------------------------------------------

	local column = newPart(model, "SteerColumn", Vector3.new(0.42, 1.6, 0.42), L(0, 3.42, -2.87) * raked, C.DarkMetal, {
		massless = false,
		material = Enum.Material.Metal,
		physical = COLUMN_PROPS,
	})

	local function onColumn(p: Part): Part
		weld(column, p)
		return p
	end

	local function columnTube(name: string, from: Vector3, to: Vector3, thickness: number, color: Color3): Part
		local cf, length = tube(from, to)
		local p = newPart(model, name, Vector3.new(length, thickness, thickness), baseCF * cf * CFrame.Angles(0, math.pi / 2, 0), color, {
			shape = Enum.PartType.Cylinder,
			material = Enum.Material.Metal,
		})
		weld(column, p)
		return p
	end

	onColumn(newPart(model, "TripleClampTop", Vector3.new(1.05, 0.24, 0.58), L(0, 3.90, -2.69) * raked, C.Silver, {
		material = Enum.Material.Metal,
		reflectance = 0.15,
	}))
	onColumn(newPart(model, "TripleClampBottom", Vector3.new(1.05, 0.24, 0.58), L(0, 3.08, -3.09) * raked, C.Silver, {
		material = Enum.Material.Metal,
		reflectance = 0.15,
	}))
	onColumn(newPart(model, "SteerNut", Vector3.new(0.3, 0.18, 0.3), L(0, 4.02, -2.63) * raked, C.Gold, {
		shape = Enum.PartType.Cylinder,
		material = Enum.Material.Metal,
	}))

	-- Upside-down forks: black lowers, gold stanchions, rubber boots.
	local axle = G.FrontAxle
	local forkDir = Vector3.new(0, math.cos(rake), math.sin(rake))
	for _, side in { -1, 1 } do
		local tag = side < 0 and "L" or "R"
		local bottom = Vector3.new(side * 0.46, axle.Y, axle.Z)
		local seal = bottom + forkDir * 1.30
		local top = bottom + forkDir * 2.48

		columnTube("ForkLower" .. tag, bottom, seal, 0.40, C.Component)
		columnTube("ForkStanchion" .. tag, seal, top, 0.30, C.Gold)

		local sealCF = baseCF * CFrame.new(seal) * CFrame.Angles(rake, 0, 0)
		onColumn(newPart(model, "ForkSeal" .. tag, Vector3.new(0.44, 0.16, 0.44), sealCF, C.Component, {
			material = Enum.Material.Metal,
		}))
		-- Accordion dust boot above the seal.
		for i = 1, 3 do
			onColumn(newPart(
				model,
				"ForkBoot" .. tag .. i,
				Vector3.new(0.38, 0.1, 0.38),
				baseCF * CFrame.new(seal + forkDir * (0.18 * i)) * CFrame.Angles(rake, 0, 0),
				C.Component
			))
		end
		-- Axle clamp at the fork foot.
		onColumn(newPart(model, "AxleClamp" .. tag, Vector3.new(0.34, 0.5, 0.5), baseCF * CFrame.new(bottom), C.Component, {
			material = Enum.Material.Metal,
		}))
	end

	onColumn(newPart(model, "FrontCaliper", Vector3.new(0.26, 0.5, 0.72), L(-0.6, 2.35, -3.5), C.Accent, {
		material = Enum.Material.Metal,
	}))
	columnTube("FrontBrakeLine", Vector3.new(-0.55, 2.6, -3.42), Vector3.new(-0.5, 3.95, -2.85), 0.08, C.Component)
	columnTube("ForkBrace", Vector3.new(-0.46, 2.95, -3.2), Vector3.new(0.46, 2.95, -3.2), 0.18, C.Silver)

	-- Bars, controls and dash.
	onColumn(newPart(model, "BarRiser", Vector3.new(0.75, 0.44, 0.32), L(0, 4.12, -2.62) * raked, C.Silver, {
		material = Enum.Material.Metal,
	}))
	onColumn(newPart(model, "Handlebar", Vector3.new(3.6, 0.2, 0.2), L(0, 4.36, -2.54), C.Component, {
		shape = Enum.PartType.Cylinder,
		material = Enum.Material.Metal,
	}))
	onColumn(newPart(model, "BarPad", Vector3.new(1.1, 0.34, 0.34), L(0, 4.36, -2.54), C.Frame, {
		shape = Enum.PartType.Cylinder,
	}))

	for _, side in { -1, 1 } do
		local tag = side < 0 and "L" or "R"
		onColumn(newPart(model, "Grip" .. tag, Vector3.new(0.86, 0.26, 0.26), L(side * 1.44, 4.36, -2.54), C.Component, {
			shape = Enum.PartType.Cylinder,
		}))
		for i = 0, 3 do
			onColumn(newPart(model, "GripRib" .. tag .. i, Vector3.new(0.08, 0.3, 0.3), L(side * (1.16 + i * 0.19), 4.36, -2.54), C.Component, {
				shape = Enum.PartType.Cylinder,
			}))
		end
		onColumn(newPart(model, "BarEnd" .. tag, Vector3.new(0.14, 0.3, 0.3), L(side * 1.88, 4.36, -2.54), C.Gold, {
			shape = Enum.PartType.Cylinder,
			material = Enum.Material.Metal,
		}))
		onColumn(newPart(model, "Lever" .. tag, Vector3.new(0.74, 0.08, 0.12), L(side * 1.02, 4.28, -2.76), C.Silver, {
			material = Enum.Material.Metal,
			reflectance = 0.2,
		}))
		onColumn(newPart(model, "Perch" .. tag, Vector3.new(0.22, 0.24, 0.24), L(side * 0.96, 4.36, -2.58), C.Component, {
			material = Enum.Material.Metal,
		}))
	end

	local dash = onColumn(newPart(model, "DashScreen", Vector3.new(0.9, 0.55, 0.12), L(0, 4.42, -2.86) * CFrame.Angles(math.rad(38), 0, 0), C.Screen, {
		material = Enum.Material.SmoothPlastic,
	}))
	local dashGui = Instance.new("SurfaceGui")
	dashGui.Name = "Display"
	dashGui.Face = Enum.NormalId.Front
	dashGui.CanvasSize = Vector2.new(220, 140)
	dashGui.LightInfluence = 0
	dashGui.Parent = dash

	local readout = Instance.new("TextLabel")
	readout.Name = "Readout"
	readout.Size = UDim2.fromScale(1, 1)
	readout.BackgroundTransparency = 1
	readout.Font = Enum.Font.Code
	readout.Text = "0\nKM/H"
	readout.TextColor3 = Color3.fromRGB(120, 255, 210)
	readout.TextScaled = true
	readout.Parent = dashGui

	-- Front plate, fender and light.
	onColumn(newPart(model, "NumberPlate", Vector3.new(1.45, 1.3, 0.12), L(0, 3.58, -3.36) * raked, C.Frame))
	onColumn(newPart(model, "PlateTrim", Vector3.new(1.5, 0.16, 0.14), L(0, 4.14, -3.09) * raked, C.Plate))
	onColumn(newPart(model, "HeadlightShell", Vector3.new(1.0, 0.6, 0.26), L(0, 3.96, -3.22) * raked, C.Component, {
		material = Enum.Material.Metal,
	}))
	onColumn(newPart(model, "Headlight", Vector3.new(0.16, 0.78, 0.78), L(0, 3.96, -3.34) * raked * CFrame.Angles(0, math.pi / 2, 0), C.Headlight, {
		shape = Enum.PartType.Cylinder,
		material = Enum.Material.Neon,
	}))
	arcPanel(column, "FrontFender", G.FrontAxle, G.FrontRadius + 0.55, -58, 34, 1.2, 0.16, 7, C.Frame)
	onColumn(newPart(model, "FenderStay", Vector3.new(0.9, 0.12, 0.5), L(0, 3.02, -3.24), C.Frame))
	onColumn(newPart(model, "HeadlightBrace", Vector3.new(0.7, 0.14, 0.5), L(0, 4.22, -3.06) * raked, C.Component, {
		material = Enum.Material.Metal,
	}))

	for _, spec in onColumnLater do
		onColumn(newPart(model, spec[1], spec[2], spec[3], C.Component, { material = Enum.Material.Metal }))
	end

	----------------------------------------------------------------------------
	-- wheels + joints
	----------------------------------------------------------------------------

	local frontWheel = buildWheel(model, "FrontWheel", G.FrontAxle, G.FrontRadius, G.FrontWidth, baseCF)
	local rearWheel = buildWheel(model, "RearWheel", G.RearAxle, G.RearRadius, G.RearWidth, baseCF)

	local sprocket = newPart(
		model,
		"RearSprocket",
		Vector3.new(0.14, rearSprocketR * 2, rearSprocketR * 2),
		baseCF * CFrame.new(G.RearAxle) * CFrame.new(chainX, 0, 0),
		C.Gold,
		{ shape = Enum.PartType.Cylinder, material = Enum.Material.Metal }
	)
	weld(rearWheel, sprocket)

	for i = 1, 18 do
		local a = (i / 18) * math.pi * 2
		local tooth = newPart(
			model,
			"SprocketTooth" .. i,
			Vector3.new(0.12, 0.18, 0.14),
			baseCF * CFrame.new(G.RearAxle) * CFrame.new(chainX, 0, 0) * CFrame.Angles(a, 0, 0) * CFrame.new(0, rearSprocketR, 0),
			C.Gold,
			{ material = Enum.Material.Metal }
		)
		weld(rearWheel, tooth)
	end

	-- Parts joined by constraints still collide, so the three colliding
	-- bodies are told explicitly not to touch each other.
	noCollide(chassis, frontWheel)
	noCollide(chassis, rearWheel)
	noCollide(frontWheel, rearWheel)

	-- Steering hinge: axis runs up the raked steering head.
	local steerAxisX = Vector3.new(0, math.cos(rake), math.sin(rake))
	local steerAxisY = Vector3.new(0, -math.sin(rake), math.cos(rake))
	local steerWorld = baseCF * CFrame.fromMatrix(G.SteerHead, steerAxisX, steerAxisY)

	local sc0, sc1 = attachPair(chassis, column, steerWorld, "Steer")
	local steerHinge = Instance.new("HingeConstraint")
	steerHinge.Name = "SteerHinge"
	steerHinge.Attachment0 = sc0
	steerHinge.Attachment1 = sc1
	steerHinge.ActuatorType = Enum.ActuatorType.Servo
	steerHinge.ServoMaxTorque = 60000
	steerHinge.AngularSpeed = Config.Handling.SteerSpeed
	steerHinge.TargetAngle = 0
	steerHinge.LimitsEnabled = true
	steerHinge.LowerAngle = -Config.Handling.MaxSteerAngle
	steerHinge.UpperAngle = Config.Handling.MaxSteerAngle
	steerHinge.Parent = chassis

	-- Front axle: free spinning.
	local fw0, fw1 = attachPair(column, frontWheel, baseCF * CFrame.new(G.FrontAxle), "FrontAxle")
	local frontHinge = Instance.new("HingeConstraint")
	frontHinge.Name = "FrontHinge"
	frontHinge.Attachment0 = fw0
	frontHinge.Attachment1 = fw1
	frontHinge.ActuatorType = Enum.ActuatorType.None
	frontHinge.Parent = column

	-- Rear axle: the driven wheel.
	local rw0, rw1 = attachPair(chassis, rearWheel, baseCF * CFrame.new(G.RearAxle), "RearAxle")
	local rearHinge = Instance.new("HingeConstraint")
	rearHinge.Name = "RearHinge"
	rearHinge.Attachment0 = rw0
	rearHinge.Attachment1 = rw1
	rearHinge.ActuatorType = Enum.ActuatorType.Motor
	rearHinge.MotorMaxTorque = Config.Drive.MotorTorque
	rearHinge.MotorMaxAcceleration = Config.Drive.MotorAcceleration
	rearHinge.AngularVelocity = 0
	rearHinge.Parent = chassis

	----------------------------------------------------------------------------
	-- stabiliser -- upright balance AND the wheelie pitch
	----------------------------------------------------------------------------

	local stabAtt = Instance.new("Attachment")
	stabAtt.Name = "StabilizerAttachment"
	stabAtt.Parent = chassis

	local stabilizer = Instance.new("AlignOrientation")
	stabilizer.Name = "Stabilizer"
	stabilizer.Mode = Enum.OrientationAlignmentMode.OneAttachment
	stabilizer.Attachment0 = stabAtt
	stabilizer.RigidityEnabled = false
	stabilizer.MaxTorque = Config.Handling.StabilizerTorque
	stabilizer.MaxAngularVelocity = math.huge
	stabilizer.Responsiveness = Config.Handling.StabilizerResponsiveness
	stabilizer.CFrame = baseCF.Rotation
	stabilizer.Parent = chassis

	----------------------------------------------------------------------------
	-- rider seat
	----------------------------------------------------------------------------

	local seat = Instance.new("VehicleSeat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(1.4, 0.5, 1.7)
	seat.CFrame = L(0, 3.98, 1.05)
	seat.Transparency = 1
	seat.CanCollide = false
	seat.Massless = true
	seat.HeadsUpDisplay = false
	seat.MaxSpeed = 0 -- legacy Motor driving is unused; the scripts drive the hinge
	seat.Torque = 0
	seat.TurnSpeed = 0
	seat.Parent = model
	weld(chassis, seat)

	-- The frame colour is used only by frame parts, so one pass tags them all
	-- as repaintable rather than threading an option through every call.
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and part:GetAttribute("Paint") == nil and part.Color == C.Frame then
			part:SetAttribute("Paint", "Frame")
		end
	end

	local engine = Instance.new("Sound")
	engine.Name = "Engine"
	engine.SoundId = Config.Audio.EngineSoundId
	engine.Looped = true
	engine.Volume = 0
	engine.RollOffMaxDistance = 220
	engine.RollOffMinDistance = 12
	engine.Parent = chassis

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "RidePrompt"
	prompt.ActionText = "Ride"
	prompt.ObjectText = Config.DisplayName
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = seat

	return model
end

return BikeBuilder
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX6">
      <Properties>
        <string name="Name">WorldBuilder</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source"><![CDATA[--!strict
-- WorldBuilder
-- The street map, built at runtime like everything else.
--
-- Layout: one long avenue running away from spawn to wheelie down, cross
-- streets, kerbed pavements, blocks of buildings either side, and ramps
-- scattered along the route so the jumps survive the move into town.
--
-- Ramps are described by the two ends of their riding surface, and the solid
-- is derived from that: a slab thick enough that its underside is buried below
-- the road at both ends. That way the leading edge is always sunk into the
-- ground and a wheel can never catch on a lip.

local Config = require(script.Parent.BikeConfig)

local WorldBuilder = {}

local ROAD = Color3.fromRGB(58, 59, 63)
local PAVEMENT = Color3.fromRGB(146, 147, 150)
local KERB = Color3.fromRGB(178, 179, 182)
local LINE = Color3.fromRGB(226, 222, 190)
local RAMP_COLOR = Color3.fromRGB(70, 72, 78)

local BUILDING_COLORS = {
	Color3.fromRGB(96, 88, 82),
	Color3.fromRGB(118, 112, 104),
	Color3.fromRGB(78, 84, 92),
	Color3.fromRGB(134, 118, 106),
	Color3.fromRGB(88, 94, 88),
}

local AVENUE_HALF = 22 -- half width of the main road
local PAVEMENT_W = 10
local KERB_H = 0.6

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

--------------------------------------------------------------------------------
-- ramps
--------------------------------------------------------------------------------

-- `low` and `high` are the two ends of the riding surface, on the ground and
-- at the top of the ramp respectively.
local function ramp(parent: Instance, name: string, low: Vector3, high: Vector3, width: number)
	local delta = high - low
	local run = delta.Magnitude
	if run < 0.1 then
		return
	end

	local dir = delta.Unit
	local side = Vector3.new(dir.Z, 0, -dir.X)
	if side.Magnitude < 1e-3 then
		side = Vector3.new(1, 0, 0)
	end
	side = side.Unit

	-- side:Cross(dir) always comes out pointing down for a horizontal `side`,
	-- so the flip below is guaranteed -- which leaves the frame's local +Z
	-- running toward the high end of the slope.
	local normal = side:Cross(dir).Unit
	if normal.Y < 0 then
		normal = -normal
	end

	-- Thick enough that the underside is below y = 0 at the high end too,
	-- so the ramp reads as solid and its toe is buried.
	local thickness = (high.Y - low.Y) / math.max(normal.Y, 0.2) + 2
	local centre = (low + high) * 0.5 - normal * (thickness * 0.5)
	local cf = CFrame.fromMatrix(centre, side, normal)

	part(parent, name, Vector3.new(width, thickness, run), cf, RAMP_COLOR, Enum.Material.Concrete)

	for _, s in { -1, 1 } do
		part(
			parent,
			name .. "Stripe" .. (s < 0 and "L" or "R"),
			Vector3.new(0.9, 0.14, run),
			cf * CFrame.new(s * (width * 0.5 - 0.45), thickness * 0.5, 0),
			Config.Colors.Frame
		)
	end

	part(
		parent,
		name .. "Lip",
		Vector3.new(width, 0.14, 0.7),
		cf * CFrame.new(0, thickness * 0.5, run * 0.5 - 0.35),
		Config.Colors.Frame
	)
end

local function tableTop(parent: Instance, name: string, x: number, centreZ: number, width: number, height: number, deck: number, approach: number)
	ramp(parent, name .. "Up", Vector3.new(x, 0, centreZ + deck * 0.5 + approach), Vector3.new(x, height, centreZ + deck * 0.5), width)
	part(parent, name .. "Deck", Vector3.new(width, height, deck), CFrame.new(x, height * 0.5, centreZ), RAMP_COLOR, Enum.Material.Concrete)
	ramp(parent, name .. "Down", Vector3.new(x, 0, centreZ - deck * 0.5 - approach), Vector3.new(x, height, centreZ - deck * 0.5), width)
end

--------------------------------------------------------------------------------
-- street furniture
--------------------------------------------------------------------------------

local function building(parent: Instance, name: string, x: number, z: number, w: number, d: number, h: number, color: Color3)
	part(parent, name, Vector3.new(w, h, d), CFrame.new(x, h * 0.5, z), color, Enum.Material.Brick)

	-- Window bands, inset a touch so they read as glass rather than paint.
	local floors = math.max(1, math.floor(h / 12))
	for i = 1, floors do
		local y = (i / (floors + 1)) * h
		part(parent, name .. "Glass" .. i, Vector3.new(w + 0.2, 3.2, d * 0.86), CFrame.new(x, y, z), Color3.fromRGB(58, 74, 88), Enum.Material.Glass)
		part(parent, name .. "Glass" .. i .. "B", Vector3.new(w * 0.86, 3.2, d + 0.2), CFrame.new(x, y, z), Color3.fromRGB(58, 74, 88), Enum.Material.Glass)
	end

	part(parent, name .. "Parapet", Vector3.new(w + 1.2, 1.4, d + 1.2), CFrame.new(x, h + 0.7, z), color:Lerp(Color3.new(0, 0, 0), 0.25), Enum.Material.Concrete)
end

local function lamp(parent: Instance, name: string, x: number, z: number, facing: number)
	part(parent, name .. "Post", Vector3.new(0.5, 16, 0.5), CFrame.new(x, 8, z), Color3.fromRGB(48, 50, 54), Enum.Material.Metal)
	part(parent, name .. "Arm", Vector3.new(3.4, 0.4, 0.4), CFrame.new(x + facing * 1.7, 15.8, z), Color3.fromRGB(48, 50, 54), Enum.Material.Metal)
	local head = part(parent, name .. "Head", Vector3.new(2.2, 0.5, 1.0), CFrame.new(x + facing * 3.2, 15.5, z), Color3.fromRGB(255, 236, 190), Enum.Material.Neon)
	head.CanCollide = false

	local light = Instance.new("SpotLight")
	light.Face = Enum.NormalId.Bottom
	light.Range = 34
	light.Angle = 110
	light.Brightness = 1.4
	light.Color = Color3.fromRGB(255, 238, 200)
	light.Parent = head
end

--------------------------------------------------------------------------------
-- build
--------------------------------------------------------------------------------

function WorldBuilder.Build(parent: Instance): Folder
	-- Clear anything from a previous build, plus the placeholder floor the
	-- place file ships so Studio's edit view is not empty.
	for _, name in { "City", "Course", "Floor" } do
		local existing = parent:FindFirstChild(name)
		if existing then
			existing:Destroy()
		end
	end

	local city = Instance.new("Folder")
	city.Name = "City"
	city.Parent = parent

	local floorSize = Config.World.FloorSize
	part(city, "Ground", floorSize, CFrame.new(0, -floorSize.Y * 0.5, 0), Config.World.FloorColor, Enum.Material.Concrete)

	----------------------------------------------------------------------------
	-- roads
	----------------------------------------------------------------------------

	local avenueFrom, avenueTo = 120, -460
	local avenueLength = avenueFrom - avenueTo
	local avenueZ = (avenueFrom + avenueTo) * 0.5

	part(city, "Avenue", Vector3.new(AVENUE_HALF * 2, 0.4, avenueLength), CFrame.new(0, 0.2, avenueZ), ROAD, Enum.Material.Asphalt)

	-- Centre dashes.
	for z = avenueTo + 10, avenueFrom - 10, 20 do
		part(city, "Dash" .. z, Vector3.new(1.1, 0.12, 9), CFrame.new(0, 0.44, z), LINE)
	end
	-- Edge lines.
	for _, s in { -1, 1 } do
		part(city, "EdgeLine" .. (s < 0 and "L" or "R"), Vector3.new(0.7, 0.12, avenueLength), CFrame.new(s * (AVENUE_HALF - 2.5), 0.44, avenueZ), LINE)
	end

	-- Pavements and kerbs down both sides.
	for _, s in { -1, 1 } do
		local tag = s < 0 and "L" or "R"
		local kerbX = s * (AVENUE_HALF + 0.6)
		part(city, "Kerb" .. tag, Vector3.new(1.2, KERB_H + 0.4, avenueLength), CFrame.new(kerbX, (KERB_H + 0.4) * 0.5, avenueZ), KERB, Enum.Material.Concrete)
		part(
			city,
			"Pavement" .. tag,
			Vector3.new(PAVEMENT_W, KERB_H + 0.4, avenueLength),
			CFrame.new(s * (AVENUE_HALF + 1.2 + PAVEMENT_W * 0.5), (KERB_H + 0.4) * 0.5, avenueZ),
			PAVEMENT,
			Enum.Material.Concrete
		)
	end

	-- Cross streets.
	local crossZ = { 60, -60, -190, -330 }
	for i, z in crossZ do
		part(city, "Cross" .. i, Vector3.new(380, 0.4, 34), CFrame.new(0, 0.2, z), ROAD, Enum.Material.Asphalt)
		for x = -170, 170, 20 do
			part(city, "CrossDash" .. i .. "_" .. x, Vector3.new(9, 0.12, 1.1), CFrame.new(x, 0.44, z), LINE)
		end
	end

	----------------------------------------------------------------------------
	-- buildings
	----------------------------------------------------------------------------

	local plots = {
		{ z = 100, d = 46 },
		{ z = 20, d = 54 },
		{ z = -120, d = 78 },
		{ z = -250, d = 60 },
		{ z = -395, d = 66 },
	}
	local index = 0
	for _, plot in plots do
		for _, s in { -1, 1 } do
			index += 1
			local w = 44 + (index % 3) * 12
			local h = 34 + ((index * 17) % 5) * 16
			local x = s * (AVENUE_HALF + 1.2 + PAVEMENT_W + w * 0.5 + 2)
			building(city, "Block" .. index, x, plot.z, w, plot.d, h, BUILDING_COLORS[(index % #BUILDING_COLORS) + 1])
		end
	end

	-- Lamp posts alternating down the avenue.
	local lampIndex = 0
	for z = avenueFrom - 30, avenueTo + 30, -70 do
		lampIndex += 1
		local s = (lampIndex % 2 == 0) and 1 or -1
		lamp(city, "Lamp" .. lampIndex, s * (AVENUE_HALF + 3), z, -s)
	end

	----------------------------------------------------------------------------
	-- jumps, dotted along the route
	----------------------------------------------------------------------------

	-- A gentle one right off the spawn, to learn on.
	ramp(city, "StepUp", Vector3.new(0, 0, 96), Vector3.new(0, 2, 84), 38)

	-- Kickers down the avenue, getting bigger.
	ramp(city, "KickerSmall", Vector3.new(0, 0, 12), Vector3.new(0, 3.2, 0), 26)
	ramp(city, "KickerMedium", Vector3.new(0, 0, -100), Vector3.new(0, 5.5, -118), 28)
	tableTop(city, "TableTop", 0, -230, 30, 6.5, 22, 20)
	ramp(city, "KickerBig", Vector3.new(0, 0, -368), Vector3.new(0, 9.5, -392), 30)
	ramp(city, "BigLanding", Vector3.new(0, 0, -448), Vector3.new(0, 7, -423), 34)

	-- A steep launcher in the side lot off the second cross street.
	part(city, "Lot", Vector3.new(90, 0.4, 90), CFrame.new(-118, 0.2, -60), ROAD, Enum.Material.Asphalt)
	ramp(city, "Launcher", Vector3.new(-118, 0, -30), Vector3.new(-118, 11, -48), 22)

	-- A roller pair on the far pavement -- wheelie straight over both.
	ramp(city, "RollerUp", Vector3.new(118, 0, -160), Vector3.new(118, 2.5, -176), 26)
	ramp(city, "RollerDown", Vector3.new(118, 0, -208), Vector3.new(118, 2.5, -192), 26)
	part(city, "RollerLot", Vector3.new(60, 0.4, 120), CFrame.new(118, 0.2, -184), ROAD, Enum.Material.Asphalt)

	return city
end

return WorldBuilder
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX7">
      <Properties>
        <string name="Name">RiderPose</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source"><![CDATA[--!strict
-- RiderPose
-- Every rider animation in the game, built the same way the bike is: in code,
-- at runtime. No uploaded animation assets.
--
-- Roblox animations are just Motor6D.Transform values written every frame, so
-- that is exactly what this does. Every client runs it for every rider, which
-- is how a normal animation would replicate anyway.
--
-- Poses are absolute, not additive. Whatever is currently on screen is eased
-- toward the active pose each frame, so switching between any two tricks --
-- or dropping back to seated -- blends smoothly with no bookkeeping.

local Config = require(script.Parent.BikeConfig)

local RiderPose = {}

local R = Config.Rider

-- Every R15 joint's C0/C1 is rotation-free in the rest pose, so a Transform
-- rotation acts in character space:
--   +X swings a downward-pointing limb FORWARD, -X swings it back
--   -X on the waist leans the chest forward
--   +Z on a shoulder/hip swings that limb toward the rider's right
local function ang(x: number, y: number, z: number): CFrame
	return CFrame.Angles(math.rad(x), math.rad(y), math.rad(z))
end

type Pose = { [string]: CFrame }
type Offset = { Lift: number, Forward: number, Pitch: number }

-- Sat down and riding: knees up on the pegs, leaning into the bars.
local SEATED: Pose = {
	Waist = ang(-26, 0, 0),
	Neck = ang(16, 0, 0),
	LeftHip = ang(70, 0, 9),
	RightHip = ang(70, 0, -9),
	LeftKnee = ang(-84, 0, 0),
	RightKnee = ang(-84, 0, 0),
	LeftAnkle = ang(18, 0, 0),
	RightAnkle = ang(18, 0, 0),
	LeftShoulder = ang(56, 0, 13),
	RightShoulder = ang(56, 0, -13),
	LeftElbow = ang(-24, 0, 0),
	RightElbow = ang(-24, 0, 0),
	LeftWrist = ang(6, 0, 0),
	RightWrist = ang(6, 0, 0),
}

-- Up off the seat, on the pegs, chest over the bars.
local STAND: Pose = {
	Waist = ang(-40, 0, 0),
	Neck = ang(28, 0, 0),
	LeftHip = ang(14, 0, 7),
	RightHip = ang(14, 0, -7),
	LeftKnee = ang(-24, 0, 0),
	RightKnee = ang(-24, 0, 0),
	LeftAnkle = ang(12, 0, 0),
	RightAnkle = ang(12, 0, 0),
	LeftShoulder = ang(70, 0, 9),
	RightShoulder = ang(70, 0, -9),
	LeftElbow = ang(-12, 0, 0),
	RightElbow = ang(-12, 0, 0),
	LeftWrist = ang(0, 0, 0),
	RightWrist = ang(0, 0, 0),
}

-- Hands off the bars, arms thrown out wide.
local NO_HANDER: Pose = {
	Waist = ang(-14, 0, 0),
	Neck = ang(6, 0, 0),
	LeftHip = ang(26, 0, 8),
	RightHip = ang(26, 0, -8),
	LeftKnee = ang(-38, 0, 0),
	RightKnee = ang(-38, 0, 0),
	LeftAnkle = ang(14, 0, 0),
	RightAnkle = ang(14, 0, 0),
	LeftShoulder = ang(12, 0, -78),
	RightShoulder = ang(12, 0, 78),
	LeftElbow = ang(-8, 0, 0),
	RightElbow = ang(-8, 0, 0),
	LeftWrist = ang(0, 0, 0),
	RightWrist = ang(0, 0, 0),
}

-- Legs kicked straight out behind, flat over the bike.
local SUPERMAN: Pose = {
	Waist = ang(-56, 0, 0),
	Neck = ang(46, 0, 0),
	LeftHip = ang(-74, 0, 10),
	RightHip = ang(-74, 0, -10),
	LeftKnee = ang(-6, 0, 0),
	RightKnee = ang(-6, 0, 0),
	LeftAnkle = ang(-16, 0, 0),
	RightAnkle = ang(-16, 0, 0),
	LeftShoulder = ang(78, 0, 6),
	RightShoulder = ang(78, 0, -6),
	LeftElbow = ang(-4, 0, 0),
	RightElbow = ang(-4, 0, 0),
	LeftWrist = ang(0, 0, 0),
	RightWrist = ang(0, 0, 0),
}

-- Right leg swung across the bike, hands still on the bars.
local CAN_CAN: Pose = {
	Waist = ang(-22, 0, 0),
	Neck = ang(14, 0, 0),
	LeftHip = ang(64, 0, 8),
	RightHip = ang(46, 0, -66),
	LeftKnee = ang(-78, 0, 0),
	RightKnee = ang(-52, 0, 0),
	LeftAnkle = ang(16, 0, 0),
	RightAnkle = ang(6, 0, 0),
	LeftShoulder = ang(60, 0, 11),
	RightShoulder = ang(60, 0, -11),
	LeftElbow = ang(-20, 0, 0),
	RightElbow = ang(-20, 0, 0),
	LeftWrist = ang(4, 0, 0),
	RightWrist = ang(4, 0, 0),
}

local POSES: { [string]: Pose } = {
	Seated = SEATED,
	Stand = STAND,
	NoHander = NO_HANDER,
	Superman = SUPERMAN,
	CanCan = CAN_CAN,
}

-- How far the rider rises off the seat and leans forward for each pose.
local OFFSETS: { [string]: Offset } = {
	Seated = { Lift = 0, Forward = 0, Pitch = 0 },
	Stand = { Lift = R.StandLift, Forward = R.StandForward, Pitch = R.StandPitch },
	NoHander = { Lift = R.StandLift * 0.8, Forward = R.StandForward * 0.5, Pitch = -4 },
	Superman = { Lift = R.StandLift * 1.3, Forward = R.StandForward * 1.7, Pitch = -16 },
	CanCan = { Lift = R.StandLift * 0.9, Forward = R.StandForward * 0.6, Pitch = -5 },
}

-- R6 has one joint per limb instead of two, and its C0s carry rotations, so
-- the poses above are mapped onto whatever joint owns that limb. The
-- conjugation in applyJoint handles the rotated C0s, so the same pose data
-- drives both rigs.
local R6_MAP: { [string]: string } = {
	Waist = "RootJoint",
	Neck = "Neck",
	LeftShoulder = "Left Shoulder",
	RightShoulder = "Right Shoulder",
	LeftHip = "Left Hip",
	RightHip = "Right Hip",
}

type State = {
	joints: { [string]: Motor6D },
	rendered: { [string]: CFrame },
	lift: number,
	forward: number,
	pitch: number,
	seatWeld: Weld?,
	baseC0: CFrame?,
	animate: LocalScript?,
}

local states: { [Model]: State } = {}

-- Poses are written in character space, but Transform is applied in the
-- joint's own frame. For R15 every C0 is rotation-free so the two are the
-- same; for R6 they are not, so the rotation is conjugated into joint space.
local function applyJoint(joint: Motor6D, characterSpace: CFrame)
	local c0 = joint.C0.Rotation
	joint.Transform = c0:Inverse() * characterSpace * c0
end

local function collect(character: Model): { [string]: Motor6D }
	local joints: { [string]: Motor6D } = {}
	for _, d in character:GetDescendants() do
		if d:IsA("Motor6D") then
			joints[d.Name] = d
		end
	end
	return joints
end

local function stopAnimator(character: Model)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return
	end
	for _, track in animator:GetPlayingAnimationTracks() do
		track:Stop(0)
	end
end

--------------------------------------------------------------------------------

-- Call every frame while the character is riding. `trick` is a key of POSES,
-- or nil for the ordinary seated riding pose.
function RiderPose.Update(character: Model, trick: string?, dt: number)
	local state = states[character]
	if not state then
		-- Take the rig over: the default sit animation would fight us for the
		-- same Motor6D.Transform values every frame.
		local animate = character:FindFirstChild("Animate")
		if animate and animate:IsA("LocalScript") and animate.Enabled then
			animate.Enabled = false
		else
			animate = nil
		end
		stopAnimator(character)

		state = {
			joints = collect(character),
			rendered = {},
			lift = 0,
			forward = 0,
			pitch = 0,
			seatWeld = nil,
			baseC0 = nil,
			animate = animate :: LocalScript?,
		}
		states[character] = state
	end

	local key = (trick ~= nil and POSES[trick] ~= nil) and trick or "Seated"
	local pose = POSES[key]
	local offset = OFFSETS[key]
	local blend = 1 - math.exp(-R.BlendSpeed * dt)

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local isR15 = humanoid ~= nil and humanoid.RigType == Enum.HumanoidRigType.R15

	for name, targetCF in pose do
		local jointName = name
		if not isR15 then
			jointName = R6_MAP[name]
		end
		local joint = jointName and state.joints[jointName]
		if joint and joint.Parent then
			local current = state.rendered[jointName] or CFrame.identity
			local nextCF = current:Lerp(targetCF, blend)
			state.rendered[jointName] = nextCF
			applyJoint(joint, nextCF)
		end
	end

	-- Lift the rider off the seat. The seat weld's C0 is axis-aligned with the
	-- seat, so this offset is in bike space and tips with the bike.
	state.lift += (offset.Lift - state.lift) * blend
	state.forward += (offset.Forward - state.forward) * blend
	state.pitch += (offset.Pitch - state.pitch) * blend

	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		local seatWeld = root:FindFirstChild("SeatWeld")
		if seatWeld and seatWeld:IsA("Weld") then
			if state.seatWeld ~= seatWeld then
				state.seatWeld = seatWeld
				state.baseC0 = seatWeld.C0
			end
			local base = state.baseC0
			if base then
				seatWeld.C0 = base
					* CFrame.new(0, state.lift, -state.forward)
					* CFrame.Angles(math.rad(state.pitch), 0, 0)
			end
		end
	end
end

-- Hand the rig back to the normal animation system.
function RiderPose.Release(character: Model)
	local state = states[character]
	if not state then
		return
	end
	states[character] = nil

	for _, joint in state.joints do
		if joint.Parent then
			joint.Transform = CFrame.identity
		end
	end

	local seatWeld = state.seatWeld
	if seatWeld and seatWeld.Parent and state.baseC0 then
		seatWeld.C0 = state.baseC0
	end

	if state.animate and state.animate.Parent then
		state.animate.Enabled = true
	end
end

return RiderPose
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX8">
      <Properties>
        <string name="Name">Ragdoll</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source"><![CDATA[--!strict
-- Ragdoll
-- Turns a character limp and puts it back together again. Server-side only:
-- the joints it swaps are physical, so they have to be authoritative.
--
-- Every Motor6D is disabled and replaced by a BallSocketConstraint pinned to
-- the same two points, which is what lets the limbs swing. The originals are
-- kept so standing back up is just a matter of switching them back on.

local Ragdoll = {}

local active: { [Model]: { motors: { Motor6D }, holder: Folder, neck: boolean } } = {}

local function limbsOf(character: Model): { Motor6D }
	local motors: { Motor6D } = {}
	for _, d in character:GetDescendants() do
		if d:IsA("Motor6D") and d.Part0 and d.Part1 then
			table.insert(motors, d)
		end
	end
	return motors
end

function Ragdoll.IsRagdolled(character: Model): boolean
	return active[character] ~= nil
end

function Ragdoll.Enable(character: Model)
	if active[character] then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end

	local motors = limbsOf(character)
	if #motors == 0 then
		return
	end

	local holder = Instance.new("Folder")
	holder.Name = "RagdollJoints"
	holder.Parent = character

	local neckWasRequired = humanoid.RequiresNeck
	humanoid.RequiresNeck = false
	humanoid.BreakJointsOnDeath = false
	humanoid.PlatformStand = true
	humanoid:ChangeState(Enum.HumanoidStateType.Physics)

	for _, motor in motors do
		local part0, part1 = motor.Part0, motor.Part1
		if part0 and part1 then
			local a0 = Instance.new("Attachment")
			a0.Name = motor.Name .. "RagdollA"
			a0.CFrame = motor.C0
			a0.Parent = part0

			local a1 = Instance.new("Attachment")
			a1.Name = motor.Name .. "RagdollB"
			a1.CFrame = motor.C1
			a1.Parent = part1

			local socket = Instance.new("BallSocketConstraint")
			socket.Name = motor.Name .. "Socket"
			socket.Attachment0 = a0
			socket.Attachment1 = a1
			socket.LimitsEnabled = true
			socket.UpperAngle = 50
			socket.TwistLimitsEnabled = true
			socket.TwistLowerAngle = -40
			socket.TwistUpperAngle = 40
			socket.Parent = holder

			motor.Enabled = false
		end
	end

	-- Limbs need to collide with the world or the rider sinks through the road.
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
			d.CanCollide = true
		end
	end

	active[character] = { motors = motors, holder = holder, neck = neckWasRequired }
end

function Ragdoll.Disable(character: Model)
	local state = active[character]
	if not state then
		return
	end
	active[character] = nil

	if state.holder.Parent then
		state.holder:Destroy()
	end

	for _, motor in state.motors do
		if motor.Parent then
			motor.Enabled = true
		end
	end

	for _, d in character:GetDescendants() do
		if d:IsA("Attachment") and d.Name:find("Ragdoll[AB]$") then
			d:Destroy()
		end
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.RequiresNeck = state.neck
		humanoid.PlatformStand = false
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
end

return Ragdoll
]]></ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX11">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBX10">
      <Properties>
        <string name="Name">BikeServer</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source"><![CDATA[--!strict
-- BikeServer
-- Owns the world, the single beta bike, who is riding it, and what happens
-- when they bin it. The riding client simulates the bike (it gets network
-- ownership), so this script only takes the wheel while the bike is parked
-- or crashed.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("BikeConfig"))
local BikeBuilder = require(ReplicatedStorage:WaitForChild("BikeBuilder"))
local WorldBuilder = require(ReplicatedStorage:WaitForChild("WorldBuilder"))
local Ragdoll = require(ReplicatedStorage:WaitForChild("Ragdoll"))

--------------------------------------------------------------------------------
-- remotes
--------------------------------------------------------------------------------

local remotes = ReplicatedStorage:FindFirstChild("BikeRemotes")
if not remotes then
	remotes = Instance.new("Folder")
	remotes.Name = "BikeRemotes"
	remotes.Parent = ReplicatedStorage
end

local function ensureRemote(name: string): RemoteEvent
	local existing = remotes:FindFirstChild(name)
	if existing and existing:IsA("RemoteEvent") then
		return existing
	end
	local ev = Instance.new("RemoteEvent")
	ev.Name = name
	ev.Parent = remotes
	return ev
end

local driverChanged = ensureRemote("DriverChanged")
local resetBike = ensureRemote("ResetBike")
local setStance = ensureRemote("SetStance") -- driver -> server, which trick they are holding
local stanceChanged = ensureRemote("StanceChanged") -- server -> everyone
local crashBike = ensureRemote("CrashBike")
local crashed = ensureRemote("Crashed")
local paintBike = ensureRemote("PaintBike")

--------------------------------------------------------------------------------
-- world
--------------------------------------------------------------------------------

WorldBuilder.Build(workspace)

local existingSpawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
if existingSpawn then
	existingSpawn.Position = Vector3.new(0, 1.2, 62)
else
	local spawnPad = Instance.new("SpawnLocation")
	spawnPad.Name = "SpawnPad"
	spawnPad.Size = Vector3.new(14, 1, 14)
	spawnPad.Position = Vector3.new(0, 1.2, 62)
	spawnPad.Anchored = true
	spawnPad.Color = Color3.fromRGB(118, 118, 121)
	spawnPad.Material = Enum.Material.SmoothPlastic
	spawnPad.Parent = workspace
end

--------------------------------------------------------------------------------
-- the bike
--------------------------------------------------------------------------------

local validTricks: { [string]: boolean } = {}
for _, trick in Config.Tricks do
	validTricks[trick.Id] = true
end

local bike: Model
local chassis: Part
local seat: VehicleSeat
local stabilizer: AlignOrientation
local rearHinge: HingeConstraint
local steerHinge: HingeConstraint

local currentDriver: Player? = nil
local crashing = false

local function setNetworkOwner(player: Player?)
	for _, part in bike:GetDescendants() do
		if part:IsA("BasePart") then
			pcall(function()
				part:SetNetworkOwner(player)
			end)
		end
	end
end

local function parkPose()
	for _, part in bike:GetDescendants() do
		if part:IsA("BasePart") then
			part.AssemblyLinearVelocity = Vector3.zero
			part.AssemblyAngularVelocity = Vector3.zero
		end
	end
	bike:PivotTo(Config.SpawnCFrame)
	stabilizer.CFrame = Config.SpawnCFrame.Rotation
	stabilizer.MaxTorque = Config.Handling.StabilizerTorque
	rearHinge.AngularVelocity = 0
	steerHinge.TargetAngle = 0
end

local function resetToSpawn()
	local driver = currentDriver
	setNetworkOwner(nil)
	parkPose()
	if driver then
		task.delay(0.2, function()
			if currentDriver == driver then
				setNetworkOwner(driver)
			end
		end)
	end
end

--------------------------------------------------------------------------------
-- crashing
--------------------------------------------------------------------------------

local function doCrash(reason: string)
	if crashing then
		return
	end

	local occupant = seat.Occupant
	local character = occupant and occupant.Parent :: Model?
	local rider = currentDriver
	if not (occupant and character and rider) then
		return
	end

	crashing = true

	-- Throw the rider off. Breaking the seat weld first stops the humanoid
	-- being dragged along by the bike as it tumbles.
	local launch = chassis.AssemblyLinearVelocity
	local weld = seat:FindFirstChild("SeatWeld")
	if weld then
		weld:Destroy()
	end
	occupant.Sit = false

	Ragdoll.Enable(character)

	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		local up = Vector3.new(0, Config.Crash.EjectImpulse, 0)
		local spin = chassis.CFrame.LookVector * (reason == "LoopOut" and -18 or 22)
		root:ApplyImpulse((launch * 0.6 + up + spin) * root.AssemblyMass)
	end

	-- Let the bike tumble on its own instead of snapping back upright.
	stabilizer.MaxTorque = 0
	setNetworkOwner(nil)

	stanceChanged:FireAllClients(rider, nil)
	crashed:FireAllClients(rider, reason)

	task.delay(Config.Crash.RagdollTime, function()
		if character.Parent then
			Ragdoll.Disable(character)
		end
		parkPose()
		crashing = false
	end)
end

--------------------------------------------------------------------------------
-- mounting
--------------------------------------------------------------------------------

local function onOccupantChanged()
	local occupant = seat.Occupant
	local player: Player? = nil
	if occupant then
		local character = occupant.Parent
		if character then
			player = Players:GetPlayerFromCharacter(character)
		end
	end

	local previous = currentDriver
	currentDriver = player
	setNetworkOwner(player)

	if previous and previous ~= player then
		stanceChanged:FireAllClients(previous, nil)
	end

	-- The ride prompt also lives on E, so it has to get out of the way while
	-- someone is aboard or it would fight the stand-up trick.
	local prompt = seat:FindFirstChild("RidePrompt")
	if prompt and prompt:IsA("ProximityPrompt") then
		prompt.Enabled = player == nil
	end

	driverChanged:FireAllClients(bike, player)
end

local function spawnBike()
	if bike then
		bike:Destroy()
	end

	bike = BikeBuilder.Build(Config.SpawnCFrame)
	bike.Parent = workspace

	chassis = bike:FindFirstChild("Chassis") :: Part
	seat = bike:FindFirstChild("DriverSeat") :: VehicleSeat
	stabilizer = chassis:FindFirstChild("Stabilizer") :: AlignOrientation
	rearHinge = chassis:FindFirstChild("RearHinge") :: HingeConstraint
	steerHinge = chassis:FindFirstChild("SteerHinge") :: HingeConstraint

	currentDriver = nil
	crashing = false

	seat:GetPropertyChangedSignal("Occupant"):Connect(onOccupantChanged)

	local prompt = seat:FindFirstChild("RidePrompt") :: ProximityPrompt
	prompt.Triggered:Connect(function(player)
		if seat.Occupant or crashing then
			return
		end
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health > 0 and not Ragdoll.IsRagdolled(character :: Model) then
			seat:Sit(humanoid)
		end
	end)

	driverChanged:FireAllClients(bike, nil)
end

spawnBike()

--------------------------------------------------------------------------------
-- customisation
--------------------------------------------------------------------------------

local paintState = { frame = 1, rim = 1, tyre = 1 }

local function applyPaint()
	local frameColor = Config.Paint.Frame[paintState.frame].Color
	local rimColor = Config.Paint.Rim[paintState.rim].Color
	local street = Config.Paint.Tyre[paintState.tyre] == "Street"

	for _, part in bike:GetDescendants() do
		if part:IsA("BasePart") then
			local role = part:GetAttribute("Paint")
			if role == "Frame" then
				part.Color = frameColor
			elseif role == "Rim" then
				part.Color = rimColor
			elseif role == "Knob" then
				-- The street tyre is the same carcass with the tread hidden.
				part.Transparency = street and 1 or 0
			end
		end
	end
end

paintBike.OnServerEvent:Connect(function(player, frameIndex, rimIndex, tyreIndex)
	if typeof(frameIndex) ~= "number" or typeof(rimIndex) ~= "number" or typeof(tyreIndex) ~= "number" then
		return
	end
	-- Only ever index into the palette, so a crafted message cannot set an
	-- arbitrary colour or property.
	local frame = math.clamp(math.floor(frameIndex), 1, #Config.Paint.Frame)
	local rim = math.clamp(math.floor(rimIndex), 1, #Config.Paint.Rim)
	local tyre = math.clamp(math.floor(tyreIndex), 1, #Config.Paint.Tyre)

	paintState.frame, paintState.rim, paintState.tyre = frame, rim, tyre
	applyPaint()
end)

--------------------------------------------------------------------------------
-- upkeep
--------------------------------------------------------------------------------

local resetDebounce: { [Player]: number } = {}

resetBike.OnServerEvent:Connect(function(player)
	local now = os.clock()
	if (resetDebounce[player] or 0) > now then
		return
	end
	resetDebounce[player] = now + 1.5

	if currentDriver ~= nil and currentDriver ~= player then
		return
	end
	resetToSpawn()
end)

crashBike.OnServerEvent:Connect(function(player, reason)
	if player ~= currentDriver or typeof(reason) ~= "string" then
		return
	end
	doCrash(reason)
end)

setStance.OnServerEvent:Connect(function(player, trick)
	if player ~= currentDriver then
		return
	end
	-- nil means "back to the plain seated pose"; anything else has to name a
	-- trick that actually exists.
	if trick ~= nil and (typeof(trick) ~= "string" or not validTricks[trick]) then
		return
	end
	stanceChanged:FireAllClients(player, trick)
end)

Players.PlayerRemoving:Connect(function(player)
	resetDebounce[player] = nil
	if currentDriver == player then
		currentDriver = nil
		setNetworkOwner(nil)
	end
end)

RunService.Heartbeat:Connect(function()
	if not chassis or not chassis.Parent then
		return
	end

	if chassis.Position.Y < Config.World.FallResetY then
		resetToSpawn()
		return
	end

	-- While nobody is riding, hold the bike upright so it never lies on its
	-- side waiting for the next player. Once someone mounts, the driving
	-- client takes over these three properties -- and while it is crashing,
	-- nobody does, so it can tumble.
	if seat.Occupant or crashing then
		return
	end

	local look = chassis.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(0, 0, -1)
	end
	stabilizer.CFrame = CFrame.lookAt(Vector3.zero, flat.Unit)
	rearHinge.AngularVelocity = 0
	steerHinge.TargetAngle = 0
end)
]]></ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX14">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX13">
    <Properties>
      <string name="Name">StarterPlayerScripts</string>
    </Properties>
    <Item class="LocalScript" referent="RBX12">
      <Properties>
        <string name="Name">BikeClient</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source"><![CDATA[--!strict
-- BikeClient
-- Runs on whoever is sitting on the bike. That client has network ownership of
-- the whole assembly, so driving it from here is smooth and lag free.
--
-- It also poses every rider's rig and drives the engine note for everyone,
-- because both are observable from the replicated bike.
--
-- Controls
--   W / S or the mobile thumbstick .. throttle & brake
--   A / D or the mobile thumbstick .. steer
--   Q  or the WHEELIE button (hold) .. lift the front wheel
--   E / F / G / H or the trick buttons (hold) .. tricks
--   R  or the JUMP button .. jump
--   T  or the RESET button .. put the bike back on the pad
--   C  or the BIKE button .. paint shop
--   V .. toggle the chase camera

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("BikeConfig"))
local RiderPose = require(ReplicatedStorage:WaitForChild("RiderPose"))

local remotes = ReplicatedStorage:WaitForChild("BikeRemotes")
local driverChanged = remotes:WaitForChild("DriverChanged") :: RemoteEvent
local resetBike = remotes:WaitForChild("ResetBike") :: RemoteEvent
local setStance = remotes:WaitForChild("SetStance") :: RemoteEvent
local stanceChanged = remotes:WaitForChild("StanceChanged") :: RemoteEvent
local crashBike = remotes:WaitForChild("CrashBike") :: RemoteEvent
local crashed = remotes:WaitForChild("Crashed") :: RemoteEvent
local paintBike = remotes:WaitForChild("PaintBike") :: RemoteEvent

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local W = Config.Wheelie
local TOP_SPEED = Config.Drive.MaxWheelSpeed * Config.Geometry.RearRadius

--------------------------------------------------------------------------------
-- state
--------------------------------------------------------------------------------

local driving = false
local bike: Model? = nil
local chassis: Part? = nil
local frontWheel: Part? = nil
local rearWheel: Part? = nil
local seat: VehicleSeat? = nil
local stabilizer: AlignOrientation? = nil
local rearHinge: HingeConstraint? = nil
local steerHinge: HingeConstraint? = nil
local readout: TextLabel? = nil

-- The bike as it exists in the world, whether or not we are on it. Used for
-- the engine note so bystanders hear it too.
local worldChassis: Part? = nil
local worldSeat: VehicleSeat? = nil
local engineSound: Sound? = nil

local wheelieHeld = false
local pitch = 0 -- degrees of nose-up; the thing being balanced
local pitchVel = 0 -- degrees/sec
local lean = 0 -- radians of bank, positive is left
local heading: number? = nil
local nextJump = 0
local heldTricks: { [string]: boolean } = {}
local activeTrick: string? = nil
local wasGrounded = true
local mountedAt = 0
local crashSent = false
local touchInputs: { [Enum.UserInputType]: TextButton } = {}

local cameraEnabled = Config.Camera.Enabled
-- Pose name per rider, "Seated" when they are not doing anything.
local riders: { [Player]: string } = {}

local paintChoice = { frame = 1, rim = 1, tyre = 1 }

--------------------------------------------------------------------------------
-- HUD
--------------------------------------------------------------------------------

local function roundify(instance: GuiObject, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = instance
end

local gui = Instance.new("ScreenGui")
gui.Name = "WheelieHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Enabled = false
gui.Parent = playerGui

-- Balance meter. The bar runs 0 .. loop-out, with the balance pocket marked
-- in green and the danger zone in red, so the skill is legible at a glance.
local meter = Instance.new("Frame")
meter.Name = "BalanceMeter"
meter.AnchorPoint = Vector2.new(0.5, 1)
meter.Position = UDim2.new(0.5, 0, 1, -34)
meter.Size = UDim2.new(0, 360, 0, 24)
meter.BackgroundColor3 = Color3.fromRGB(18, 18, 20)
meter.BackgroundTransparency = 0.25
meter.BorderSizePixel = 0
meter.ZIndex = 2
meter.Parent = gui
roundify(meter, 12)

local sweetZone = Instance.new("Frame")
sweetZone.Name = "SweetZone"
sweetZone.BackgroundColor3 = Color3.fromRGB(64, 200, 120)
sweetZone.BackgroundTransparency = 0.55
sweetZone.BorderSizePixel = 0
sweetZone.ZIndex = 3
sweetZone.Position = UDim2.new((W.BalanceAngle - W.SweetSpot) / W.LoopOutAngle, 0, 0, 0)
sweetZone.Size = UDim2.new((W.SweetSpot * 2) / W.LoopOutAngle, 0, 1, 0)
sweetZone.Parent = meter

local dangerZone = Instance.new("Frame")
dangerZone.Name = "DangerZone"
dangerZone.BackgroundColor3 = Color3.fromRGB(220, 60, 55)
dangerZone.BackgroundTransparency = 0.55
dangerZone.BorderSizePixel = 0
dangerZone.ZIndex = 3
dangerZone.Position = UDim2.new(Config.Crash.LandingSafeMax / W.LoopOutAngle, 0, 0, 0)
dangerZone.Size = UDim2.new(1 - Config.Crash.LandingSafeMax / W.LoopOutAngle, 0, 1, 0)
dangerZone.Parent = meter

local meterFill = Instance.new("Frame")
meterFill.Name = "Fill"
meterFill.Size = UDim2.new(0, 0, 1, 0)
meterFill.BackgroundColor3 = Config.Colors.Frame
meterFill.BackgroundTransparency = 0.15
meterFill.BorderSizePixel = 0
meterFill.ZIndex = 4
meterFill.Parent = meter
roundify(meterFill, 12)

local meterLabel = Instance.new("TextLabel")
meterLabel.Size = UDim2.fromScale(1, 1)
meterLabel.BackgroundTransparency = 1
meterLabel.Font = Enum.Font.GothamBold
meterLabel.Text = "WHEELIE"
meterLabel.TextSize = 13
meterLabel.TextColor3 = Color3.new(1, 1, 1)
meterLabel.ZIndex = 5
meterLabel.Parent = meter

